{
  "description": "One inbox for all open proposals with vote counts. Vote fast, track mine.",
  "icon": {
    "image": "brand/icon.png",
    "emoji": "📥"
  },
  "secrets": [],
  "tests": [
    {
      "id": "inbox.demo-list",
      "name": "Inbox lists open proposals",
      "path": "/?demo=1",
      "expectSelector": "[data-proposal-card]",
      "expectText": "Staging demo proposal",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "inbox.share-button",
      "name": "Proposal cards offer a share button",
      "path": "/?demo=1",
      "expectSelector": "[data-share-link]",
      "impact": ["public/index.html", "dapp.json"]
    },
    {
      "id": "inbox.share-sheet",
      "name": "Share button shows Share label in sheet mode",
      "path": "/?demo=1&share=sheet",
      "expectSelector": "[data-share-link]",
      "expectText": "Share",
      "impact": ["public/index.html", "dapp.json"]
    },
    {
      "id": "inbox.share-copy",
      "name": "Share button falls back to Copy link",
      "path": "/?demo=1&share=copy",
      "expectSelector": "[data-share-link]",
      "expectText": "Copy link",
      "impact": ["public/index.html", "dapp.json"]
    },
    {
      "id": "inbox.share-copied",
      "name": "Tapping Copy link shows Copied!",
      "path": "/?demo=1&share=copy&tap-share=demo-2",
      "expectText": "Copied!",
      "impact": ["public/index.html", "dapp.json"]
    },
    {
      "id": "inbox.status-bar",
      "name": "Proposal cards show a Voting progress bar",
      "path": "/?demo=1",
      "expectSelector": "[data-proposal-status]",
      "expectText": "Voting",
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "inbox.relative-age",
      "name": "Inbox cards show relative proposal age",
      "path": "/?demo=1",
      "expectSelector": "[data-proposal-card]",
      "expectText": "ago",
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "inbox.summary-line",
      "name": "Inbox header shows open and votes-needed summary",
      "path": "/?demo=1",
      "expectSelector": "#inbox-summary",
      "expectText": "6 open, 9 votes needed"
    },
    {
      "id": "inbox.updated-line",
      "name": "Inbox header shows last updated time",
      "path": "/?demo=1",
      "expectSelector": "#inbox-updated",
      "expectText": "Updated",
      "impact": ["public/index.html", "dapp.json"]
    },
    {
      "id": "inbox.vote-undo",
      "name": "Vote confirmation toast shows Undo",
      "path": "/?demo=1&cast=demo-2:yes",
      "expectText": "Undo",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "inbox.vote-retry",
      "name": "Failed offline vote keeps the card marked with a Retry pill",
      "path": "/?demo=1&cast=demo-2:yes&failvote=1",
      "expectSelector": "[data-retry-vote]",
      "expectText": "Retry vote",
      "visual": true,
      "impact": ["public/index.html", "dapp.json"]
    },
    {
      "id": "my-votes.demo",
      "name": "My Votes shows history with status",
      "path": "/?tab=votes&demo=1",
      "expectSelector": "[data-vote-row]",
      "expectText": "You voted yes",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "my-votes.order-default",
      "name": "My Votes default order is newest vote first",
      "path": "/?tab=votes&demo=1",
      "expectSelector": "body:has([data-votes-order='newest'][aria-checked='true']) #view [data-vote-row][data-session-id='demo-v1']:first-child",
      "expectText": "weekly summary email",
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "my-votes.order-oldest",
      "name": "Oldest-first toggle reverses the My Votes list",
      "path": "/?tab=votes&demo=1&votes-order=oldest",
      "expectSelector": "body:has([data-votes-order='oldest'][aria-checked='true']) #view [data-vote-row][data-session-id='demo-v3']:first-child",
      "expectText": "pinned notes",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "my-votes.summary",
      "name": "My Votes header shows voted and merged counts",
      "path": "/?tab=votes&demo=1",
      "expectSelector": "#votes-summary",
      "expectText": "3 voted, 1 merged"
    },
    {
      "id": "my-votes.merged-date",
      "name": "My Votes shows the merged date on a merged row",
      "path": "/?tab=votes&demo=1",
      "expectSelector": "[data-vote-row][data-vote-status='merged'] [data-merged-date]",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "inbox.voter-avatars",
      "name": "Yes-voter avatar circles render on cards with yes votes",
      "path": "/?demo=1",
      "expectSelector": "[data-proposal-card] [data-voter-avatar]",
      "expectText": "+2",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "inbox.voter-names",
      "name": "Proposal cards list yes-voter display names",
      "path": "/?demo=1",
      "expectSelector": "[data-yes-voter-names]",
      "expectText": "Maya (demo)",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "app-filter.trigger",
      "name": "App filter trigger renders",
      "path": "/?demo=1",
      "expectSelector": "[data-app-filter-trigger]",
      "expectText": "All apps",
      "visual": true,
      "impact": ["public/index.html", "dapp.json"]
    },
    {
      "id": "app-filter.counts",
      "name": "App filter shows open counts per app",
      "path": "/?demo=1&openfilter=1",
      "expectSelector": "[data-app-count]",
      "expectText": "(3)",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "inbox.one-vote-away",
      "name": "One vote away chip shows only one-needed proposals",
      "path": "/?demo=1&one-away=1",
      "expectSelector": "body:has([data-one-away-chip][aria-pressed=\"true\"]) #view:not(:has([data-proposal-card]:not([data-needed=\"1\"]))) [data-proposal-card][data-needed=\"1\"]",
      "expectText": "1 vote needed",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "app-filter.persisted",
      "name": "Chosen app filter is restored after a reload",
      "path": "/?demo=1&set-filter=staging-demo-archive&set-filter-name=Staging%20Demo%20Archive",
      "expectText": "Staging Demo Archive",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "inbox.title-search",
      "name": "Title search keeps only matching cards",
      "path": "/?demo=1&q=Keyboard",
      "expectSelector": "[data-proposal-card]",
      "expectText": "keyboard shortcuts",
      "visual": true,
      "impact": ["public/index.html", "dapp.json"]
    },
    {
      "id": "inbox.title-search-empty",
      "name": "Title search shows a no-match empty state",
      "path": "/?demo=1&q=zzz-no-such-title",
      "expectText": "No proposals match",
      "impact": ["public/index.html", "dapp.json"]
    },
    {
      "id": "inbox.vote-share-bar",
      "name": "Proposal cards show proportional yes/no vote bar",
      "path": "/?demo=1",
      "expectSelector": "[data-vote-bar]",
      "expectText": "Yes 1 · No 0",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "inbox.vote-threshold",
      "name": "Proposal cards show vote threshold as X of Y",
      "path": "/?demo=1",
      "expectSelector": "[data-vote-threshold='2 of 3']",
      "expectText": "2 of 3",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "inbox.hide-voted",
      "name": "Hide voted toggle empties an all-voted inbox",
      "path": "/?demo=1&hide-voted=1&allvoted=1",
      "expectText": "Nothing left to vote on",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "inbox.hide-merged",
      "name": "Hide merged toggle empties an all-merged inbox",
      "path": "/?demo=1&hide-merged=1&allmerged=1",
      "expectText": "Merged proposals hidden",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "inbox.hide-merged-cards",
      "name": "Hide merged drops the merged card from a mixed inbox",
      "path": "/?demo=1&hide-merged=1",
      "expectSelector": "body:not(:has([data-proposal-card][data-session-id='demo-5'])) #view [data-proposal-card][data-session-id='demo-3']",
      "visual": true,
      "impact": ["public/index.html", "dapp.json"]
    },
    {
      "id": "inbox.age-groups",
      "name": "Inbox groups proposals under age headers",
      "path": "/?demo=1",
      "expectSelector": "[data-age-group] [data-age-header]",
      "expectText": "Today",
      "visual": true,
      "impact": ["public/index.html", "dapp.json"]
    },
    {
      "id": "inbox.sort-default",
      "name": "Default inbox order is most votes needed first",
      "path": "/?demo=1",
      "expectSelector": "[data-proposal-card][data-session-id='demo-4']:first-child",
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "inbox.sort-newest",
      "name": "Newest-first sort puts the most recent proposal on top",
      "path": "/?demo=1&sort=newest",
      "expectSelector": "[data-proposal-card][data-session-id='demo-2']:first-child",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "inbox.no-confirm-dialog",
      "name": "Tapping No asks for confirmation before rejecting",
      "path": "/?demo=1&tap-no=1",
      "expectText": "No, reject",
      "visual": true,
      "impact": ["public/index.html", "dapp.json"]
    },
    {
      "id": "inbox.no-confirm-cast",
      "name": "Confirming No, reject records the vote",
      "path": "/?demo=1&tap-no=1&confirm-no=1",
      "expectText": "You voted no",
      "impact": ["public/index.html", "dapp.json"]
    },
    {
      "id": "inbox.title-more",
      "name": "Long titles clamp to two lines with a More control",
      "path": "/?demo=1",
      "expectSelector": "[data-proposal-card] [data-title-toggle]",
      "expectText": "More",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "inbox.title-expand",
      "name": "More expands a clamped title to its full text",
      "path": "/?demo=1&expand=demo-4",
      "expectSelector": "[data-proposal-card][data-session-id='demo-4'] [data-title-toggle][aria-expanded='true']",
      "expectText": "Less",
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "inbox.proposed-date",
      "name": "Proposal cards show the promotion date under the app name",
      "path": "/?demo=1",
      "expectSelector": "[data-proposal-card] [data-proposed-date]",
      "expectText": "Proposed",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "bulk.select-control",
      "name": "Inbox offers a Select control",
      "path": "/?demo=1",
      "expectSelector": "[data-select-mode-toggle]",
      "expectText": "Select",
      "impact": ["public/index.html", "dapp.json"]
    },
    {
      "id": "bulk.mode-enters",
      "name": "Select mode shows the bulk bar",
      "path": "/?demo=1&selectmode=1",
      "expectSelector": "[data-select-bar]:not([hidden])"
    },
    {
      "id": "bulk.checkboxes-render",
      "name": "Select mode puts a checkbox on votable cards",
      "path": "/?demo=1&selectmode=1&select=demo-2&deselect=demo-2",
      "expectSelector": "[data-proposal-card] [data-select-toggle]"
    },
    {
      "id": "bulk.voted-not-selectable",
      "name": "Already-voted cards offer no checkbox",
      "path": "/?demo=1&selectmode=1",
      "expectSelector": "body:has([data-proposal-card][data-session-id='demo-3']):not(:has([data-proposal-card][data-session-id='demo-3'] [data-select-toggle]))"
    },
    {
      "id": "bulk.card-selects",
      "name": "Ticking a card marks it selected",
      "path": "/?demo=1&select=demo-1",
      "expectSelector": "[data-proposal-card][data-session-id='demo-1'][data-selected='true']",
      "visual": true,
      "impact": ["public/index.html", "dapp.json"]
    },
    {
      "id": "bulk.counter-one",
      "name": "Counter reads one selected",
      "path": "/?demo=1&select=demo-1",
      "expectText": "1 selected"
    },
    {
      "id": "bulk.counter-three",
      "name": "Counter reads three selected",
      "path": "/?demo=1&select=demo-1,demo-2,demo-6",
      "expectText": "3 selected"
    },
    {
      "id": "bulk.counter-empty-mode",
      "name": "Select mode with nothing ticked reads zero selected",
      "path": "/?demo=1&selectmode=1",
      "expectText": "0 selected"
    },
    {
      "id": "bulk.deselect-card",
      "name": "Unticking a card unmarks it",
      "path": "/?demo=1&select=demo-1,demo-2&deselect=demo-2",
      "expectSelector": "[data-proposal-card][data-session-id='demo-2'][data-selected='false']"
    },
    {
      "id": "bulk.counter-after-deselect",
      "name": "Counter drops after an untick",
      "path": "/?demo=1&select=demo-1,demo-2&deselect=demo-2",
      "expectText": "1 selected"
    },
    {
      "id": "bulk.approve-votes",
      "name": "Bulk approve votes yes on every selected card",
      "path": "/?demo=1&select=demo-1,demo-6&bulk=approve",
      "expectText": "You voted yes"
    },
    {
      "id": "bulk.approve-toast",
      "name": "Bulk approve names its outcome",
      "path": "/?demo=1&select=demo-1,demo-6&bulk=approve",
      "expectText": "Approved 2"
    },
    {
      "id": "bulk.approve-clears-counter",
      "name": "Counter resets after bulk approve",
      "path": "/?demo=1&select=demo-1,demo-6&bulk=approve",
      "expectText": "0 selected"
    },
    {
      "id": "bulk.hide-votes",
      "name": "Bulk hide votes no on every selected card",
      "path": "/?demo=1&select=demo-1&bulk=hide",
      "expectText": "You voted no"
    },
    {
      "id": "bulk.hide-toast",
      "name": "Bulk hide names its outcome",
      "path": "/?demo=1&select=demo-1&bulk=hide",
      "expectText": "Hid 1 proposal"
    },
    {
      "id": "bulk.clear-all",
      "name": "Clear empties the selection",
      "path": "/?demo=1&select=demo-1,demo-2&clearsel=1",
      "expectText": "0 selected"
    },
    {
      "id": "bulk.clear-unmarks",
      "name": "Clear unticks the selected cards",
      "path": "/?demo=1&select=demo-1,demo-2&clearsel=1",
      "expectSelector": "[data-proposal-card][data-session-id='demo-1'][data-selected='false']"
    },
    {
      "id": "bulk.clear-keeps-mode",
      "name": "Clear keeps select mode on",
      "path": "/?demo=1&select=demo-1,demo-2&clearsel=1",
      "expectSelector": "[data-select-bar]:not([hidden])"
    },
    {
      "id": "bulk.selection-survives-search",
      "name": "Selection survives the title search filter",
      "path": "/?demo=1&select=demo-1,demo-2,demo-4&q=tag",
      "expectText": "3 selected"
    },
    {
      "id": "bulk.selection-survives-app-filter",
      "name": "Selection survives the app filter",
      "path": "/?demo=1&select=demo-1,demo-2,demo-6&filter=staging-demo-notes",
      "expectText": "3 selected"
    },
    {
      "id": "bulk.selection-survives-one-away",
      "name": "Selection survives the one-vote-away filter",
      "path": "/?demo=1&select=demo-1,demo-2&one-away=1",
      "expectText": "2 selected"
    },
    {
      "id": "bulk.deselect-while-filtered",
      "name": "Unticking a filtered-out card keeps the counter accurate",
      "path": "/?demo=1&select=demo-1,demo-2,demo-4&filter=staging-demo-notes&deselect=demo-4",
      "expectText": "2 selected"
    },
    {
      "id": "bulk.done-exits",
      "name": "Done leaves select mode and clears the checkboxes",
      "path": "/?demo=1&select=demo-1&exitsel=1",
      "expectSelector": "body:has(#view [data-proposal-card]):not(:has([data-select-toggle]))"
    },
    {
      "id": "bulk.one-tap-in-select-mode",
      "name": "One-tap voting keeps working in select mode",
      "path": "/?demo=1&selectmode=1&cast=demo-1:yes",
      "expectText": "You voted yes"
    },
    {
      "id": "bulk.approve-button-renders",
      "name": "Bulk bar offers Approve",
      "path": "/?demo=1&selectmode=1",
      "expectSelector": "[data-bulk-approve]",
      "expectText": "Approve"
    },
    {
      "id": "bulk.hide-button-renders",
      "name": "Bulk bar offers Hide",
      "path": "/?demo=1&selectmode=1",
      "expectSelector": "[data-bulk-hide]",
      "expectText": "Hide"
    }
  ]
}