{
  "description": "One inbox for all open proposals with vote counts. Vote fast, track mine.",
  "icon": {
    "emoji": "📥"
  },
  "secrets": [],
  "tests": [
    {
      "id": "inbox.demo-list",
      "name": "Inbox lists open proposals",
      "path": "/?demo=1",
      "expectSelector": "[data-proposal-card]",
      "expectText": "Staging demo proposal",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "inbox.copy-link",
      "name": "Proposal cards offer a copy link",
      "path": "/?demo=1",
      "expectSelector": "[data-copy-link]",
      "expectText": "Copy link"
    },
    {
      "id": "inbox.status-bar",
      "name": "Proposal cards show a Voting progress bar",
      "path": "/?demo=1",
      "expectSelector": "[data-proposal-status]",
      "expectText": "Voting",
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "inbox.relative-age",
      "name": "Inbox cards show relative proposal age",
      "path": "/?demo=1",
      "expectSelector": "[data-proposal-card]",
      "expectText": "ago",
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "inbox.summary-line",
      "name": "Inbox header shows open and votes-needed summary",
      "path": "/?demo=1",
      "expectSelector": "#inbox-summary",
      "expectText": "5 open, 8 votes needed"
    },
    {
      "id": "inbox.updated-line",
      "name": "Inbox header shows last updated time",
      "path": "/?demo=1",
      "expectSelector": "#inbox-updated",
      "expectText": "Updated",
      "impact": ["public/index.html", "dapp.json"]
    },
    {
      "id": "inbox.vote-undo",
      "name": "Vote confirmation toast shows Undo",
      "path": "/?demo=1&cast=demo-2:yes",
      "expectText": "Undo",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "my-votes.demo",
      "name": "My Votes shows history with status",
      "path": "/?tab=votes&demo=1",
      "expectSelector": "[data-vote-row]",
      "expectText": "You voted yes",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "my-votes.copy-summary",
      "name": "My Votes offers a copyable summary naming voted proposals",
      "path": "/?tab=votes&demo=1",
      "expectSelector": "#copy-summary-btn[data-summary*='Staging demo proposal: weekly summary email']",
      "visual": true,
      "impact": ["public/index.html", "dapp.json"]
    },
    {
      "id": "inbox.voter-avatars",
      "name": "Yes-voter avatar circles render on cards with yes votes",
      "path": "/?demo=1",
      "expectSelector": "[data-proposal-card] [data-voter-avatar]",
      "expectText": "+2",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "inbox.voter-names",
      "name": "Proposal cards list yes-voter display names",
      "path": "/?demo=1",
      "expectSelector": "[data-yes-voter-names]",
      "expectText": "Maya (demo)",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "app-filter.trigger",
      "name": "App filter trigger renders",
      "path": "/?demo=1",
      "expectSelector": "[data-app-filter-trigger]",
      "expectText": "All apps",
      "visual": true,
      "impact": ["public/index.html", "dapp.json"]
    },
    {
      "id": "inbox.title-search",
      "name": "Title search keeps only matching cards",
      "path": "/?demo=1&q=Keyboard",
      "expectSelector": "[data-proposal-card]",
      "expectText": "keyboard shortcuts",
      "visual": true,
      "impact": ["public/index.html", "dapp.json"]
    },
    {
      "id": "inbox.title-search-empty",
      "name": "Title search shows a no-match empty state",
      "path": "/?demo=1&q=zzz-no-such-title",
      "expectText": "No proposals match",
      "impact": ["public/index.html", "dapp.json"]
    },
    {
      "id": "inbox.vote-share-bar",
      "name": "Proposal cards show proportional yes/no vote bar",
      "path": "/?demo=1",
      "expectSelector": "[data-vote-bar]",
      "expectText": "Yes 1 · No 0",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "inbox.hide-voted",
      "name": "Hide voted toggle empties an all-voted inbox",
      "path": "/?demo=1&hide-voted=1&allvoted=1",
      "expectText": "Nothing left to vote on",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "inbox.hide-merged",
      "name": "Hide merged toggle empties an all-merged inbox",
      "path": "/?demo=1&hide-merged=1&allmerged=1",
      "expectText": "Merged proposals hidden",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "inbox.sort-default",
      "name": "Default inbox order is most votes needed first",
      "path": "/?demo=1",
      "expectSelector": "[data-proposal-card][data-session-id='demo-4']:first-child",
      "impact": ["public/index.html", "server.js", "dapp.json"]
    },
    {
      "id": "inbox.sort-newest",
      "name": "Newest-first sort puts the most recent proposal on top",
      "path": "/?demo=1&sort=newest",
      "expectSelector": "[data-proposal-card][data-session-id='demo-2']:first-child",
      "visual": true,
      "impact": ["public/index.html", "server.js", "dapp.json"]
    }
  ]
}